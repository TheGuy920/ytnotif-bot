{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ytnotif-bot",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	// Hourly: renews hub subscriptions that are more than a day old (leases
	// last 5 days) and retries failed ones.
	"triggers": {
		"crons": [
			"23 * * * *"
		]
	},
	// Holds the channel list, the seen-video list and last posts. Create with
	// `npx wrangler kv namespace create STORE` and paste the id here.
	"kv_namespaces": [
		{
			"binding": "STORE",
			"id": "036d72c041404ea58bf85948c4dba76d",
			"remote": true
		}
	],
	"vars": {
		// Pins the URL the hub calls. Without it, the hub is told to call back
		// to whatever host the admin page is opened on, + /notifs.
		"CALLBACK_URL": "https://ytnotif-bot.theguy920.workers.dev/notifs",
		// Days to remember an announced video, counted from its publish date.
		// Pings for videos older than this are treated as edits and ignored.
		"SEEN_TTL_DAYS": "30"
	},
	"observability": {
		"enabled": true
	},
	// Worker Previews (Workers Builds runs `wrangler preview` on non-main
	// branches). Previews deliberately get no KV namespace, so a preview
	// can never touch the production channel list or subscriptions; its
	// pages just say storage isn't bound. To get a fully working preview,
	// create a separate namespace (`npx wrangler kv namespace create
	// STORE_preview`) and add it here as
	// "kv_namespaces": [{ "binding": "STORE", "id": "<that id>" }].
	"previews": {
		"vars": {
			"SEEN_TTL_DAYS": "30"
		}
	}
	// Secrets (npx wrangler secret put <NAME>):
	//   ADMIN_TOKEN  required; password for the admin page / API
	//   HUB_SECRET   optional but recommended; lets the Worker verify notifications come from the hub
	//   WEBHOOK_*    optional; Discord webhook URLs you'd rather keep out of KV (reference by name)
}
